# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.sqlite
*.db

# Node
node_modules/
dist/
.vite/

# Storage & Temporary Files
storage/documents/*
!storage/documents/.gitkeep
storage/temp/*
!storage/temp/.gitkeep

# Environment & IDE
.env
.env.local
.vscode/
.idea/

# Testing
.pytest_cache/

# User Requirement: DO NOT push any markdown (.md) files
*.md
